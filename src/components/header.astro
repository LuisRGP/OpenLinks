---
const { profile, avatarClass } = Astro.props;
---

<div class="text-center mb-8 animate-fade-in">
	<div class="relative inline-block mb-4">
		<img
			src={profile.avatar || "avatar/Avatar.webp"}
			alt={`${profile.name} avatar`}
			width="200"
			height="200"
			class={`${avatarClass} object-cover rounded-full`}
		/>

		<h1 class="text-2xl font-extrabold mt-6 mb-1 text-glow">
			{profile.name}
		</h1>

		<p class="text-sm max-w-xs mx-auto text-glow">
			{profile.description}
		</p>
	</div>
</div>
