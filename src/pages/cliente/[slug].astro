---

import Layout from "../../layouts/Layout.astro";
import Avatar from "../../components/header.astro";
import Link from "../../components/link.astro";
import Footer from "../../components/footer.astro";
import Adult from "../../components/adult.astro";
import { getTheme } from "../../lib/getTheme.ts";

export async function getStaticPaths() {
const modules = import.meta.glob("../../data/*.json");

const paths = [];

for (const path in modules) {
const slug = path
.split("/")
.pop()
?.replace(".json", "");

```
paths.push({
  params: { slug }
});
```

}

return paths;
}

const { slug } = Astro.params;

const data = await import(`../../data/${slug}.json`);

const profileData = data.default;

const {
links,
profile,
title,
description,
url_base,
footer
} = profileData;

## const themeStyles = getTheme(profileData.theme);

<Layout themeClass={themeStyles} meta={{ title, description, url_base }}> <Avatar slot="header" profile={profile} avatarClass={themeStyles.avatar} />

{profile.adult && <Adult />}

  <ul class="list-none space-y-4">
    {
      links.map((link) => (
        <Link
          link={link}
          buttonClass={themeStyles.links_button}
          textClass={themeStyles.links_text}
        />
      ))
    }
  </ul>

  <Footer slot="footer" footer={footer} />
</Layout>
